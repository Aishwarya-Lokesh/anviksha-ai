# Copy this file to .env and fill in your real values

# Supabase Postgres connection string — get this from your Supabase project's
# Settings -> Database -> Connection string (use the "Connection pooling" one)
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Any long random string — used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

# How long a login stays valid, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# When true, API responses mask real student names/USNs (for demos/screenshots)
DEMO_MODE=false

# Free Groq API key, from console.groq.com — powers the real Ask Anviksha
# AI assistant, PPT/Notes generator, and Question Paper features. Chosen
# for fast responses on their free tier. Leave blank and these features
# honestly report they aren't connected yet, rather than faking a response.
GROQ_API_KEY=
